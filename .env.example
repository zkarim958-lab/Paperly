# Copy to .env.local and fill in. All values are public (NEXT_PUBLIC_*).

NEXT_PUBLIC_SITE_NAME=PageForge
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_CONTACT_EMAIL=Zacknux109@gmail.com

# Leave NEXT_PUBLIC_ADSENSE_CLIENT empty while developing: ad slots show
# dashed placeholders in dev and render nothing in production.
NEXT_PUBLIC_ADSENSE_CLIENT=
# One ad-unit ID per placement (create "Display ads" units in AdSense).
NEXT_PUBLIC_AD_SLOT_LEADERBOARD=
NEXT_PUBLIC_AD_SLOT_SKY_LEFT=
NEXT_PUBLIC_AD_SLOT_SKY_RIGHT=
NEXT_PUBLIC_AD_SLOT_PROCESSING=
NEXT_PUBLIC_AD_SLOT_RESULT=
NEXT_PUBLIC_AD_SLOT_FOOTER=
# Extra responsive display unit shown right below the tool workspace.
NEXT_PUBLIC_AD_SLOT_BELOW_TOOLS=

# Optional: self-host the OCR engine so no third-party CDN is contacted.
# Copy tesseract.js's worker.min.js, tesseract-core*.wasm(.js) to /public/tesseract and
# <lang>.traineddata.gz to /public/tesseract/lang, then set:
NEXT_PUBLIC_TESSERACT_BASE=

# --- Legal details shown in the Privacy Policy and Terms (GDPR requires naming the controller).
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_OPERATOR_COUNTRY=

# --- Consent. Leave "false" to use the built-in banner (ads load only after consent where required).
# Set to "true" AFTER enabling Google's certified consent message in AdSense >
# Privacy & messaging (recommended for UK/EEA traffic). The built-in banner is then hidden.
NEXT_PUBLIC_USE_GOOGLE_CMP=false

# --- ADMIN PANEL (/admin) ---------------------------------------------------
# Required to turn the admin panel on. 8+ characters. Server-side only (no NEXT_PUBLIC_).
ADMIN_PASSWORD=Zainzain12345
# Optional. Signs the login cookie; defaults to a value derived from ADMIN_PASSWORD.
ADMIN_SECRET=
# Where admin changes are saved. Easiest on Vercel/Netlify/Cloudflare: Supabase (free).
# Project Settings > API: copy the Project URL and the service_role key (SERVER ONLY, never NEXT_PUBLIC_).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Alternative: Upstash Redis. On Vercel/serverless use Upstash Redis (free tier):
# create a database at upstash.com, copy the REST URL and token (Vercel KV names also work).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# On a VPS with a normal disk you can skip Redis: settings go to .data/settings.json
# (change the path with SETTINGS_FILE).

# The NEXT_PUBLIC_* values above are only the DEFAULTS. Whatever you save in /admin overrides them.
# Optional default for the Google Search Console HTML-tag verification code:
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
